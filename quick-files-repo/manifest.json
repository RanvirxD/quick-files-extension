{
  "manifest_version": 3,
  "name": "Quick Files",
  "version": "1.0.0",
  "description": "Save links to your important files (resume, ID, etc.) and drag them into any website without browsing again.",
  "permissions": [
    "sidePanel"
  ],
  "action": {
    "default_title": "Quick Files",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
